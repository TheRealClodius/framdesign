{
  "name": "framdesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "dev:clean": "pkill -f 'next dev' 2>/dev/null || true; lsof -ti:3000,8080 | xargs kill 2>/dev/null || true; sleep 0.5; pkill -9 -f 'next dev' 2>/dev/null || true; lsof -ti:3000,8080 | xargs kill -9 2>/dev/null || true; sleep 0.5; echo '✓ Cleaned up existing dev servers'",
    "dev:all": "npm run dev:clean && concurrently \"npm run dev\" \"npm run dev:voice\" \"npm run watch:tools\" --names \"FRONTEND,VOICE,TOOLS\" --prefix-colors \"cyan,yellow,magenta\"",
    "dev:voice": "cd voice-server && NODE_ENV=development npm run dev",
    "watch:tools": "node tools/_build/watch-tools.js",
    "build": "next build --webpack",
    "build:tools": "node tools/_build/tool-builder.js",
    "prebuild": "npm run build:tools",
    "prestart": "npm run build:tools",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:agent": "node scripts/text-agent-test.js",
    "test:voice": "tsx scripts/voice-agent-test.js",
    "generate:audio": "node scripts/generate-test-audio.js",
    "test:e2e": "npx playwright test",
    "kb:audit": "npx tsx scripts/kb-audit.ts",
    "kb:audit:fast": "npx tsx scripts/kb-audit.ts --skip-gcs --skip-qdrant"
  },
  "dependencies": {
    "@fontsource/google-sans-code": "^5.2.3",
    "@fontsource/google-sans-flex": "^5.2.1",
    "@google-cloud/storage": "^7.18.0",
    "@google/genai": "^1.35.0",
    "@next/third-parties": "^16.1.1",
    "@qdrant/js-client-rest": "^1.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.1",
    "mermaid": "^11.12.2",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tiktoken": "^1.0.22",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "glob": "^10.0.0",
    "jest": {
      "glob": "^10.0.0"
    },
    "@jest/core": {
      "glob": "^10.0.0"
    },
    "@jest/reporters": {
      "glob": "^10.0.0"
    },
    "@jest/transform": {
      "glob": "^10.0.0"
    },
    "jest-config": {
      "glob": "^10.0.0"
    },
    "jest-cli": {
      "glob": "^10.0.0"
    },
    "babel-plugin-istanbul": {
      "glob": "^10.0.0"
    },
    "test-exclude": {
      "glob": "^10.0.0"
    }
  }
}
